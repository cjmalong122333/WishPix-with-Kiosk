# WishPix web app (Next.js). Copy to .env and fill in.
# Empty values mean "not set"; every AI service has a free fallback.

# --- Server ---
PORT=3000
HOST=0.0.0.0
# Long random string; signs teacher sign-ins. REQUIRED in production.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# SQLite database and generated pictures.
DATABASE_URL=file:./data/wishpix.db
DATA_DIR=./data
# Only the screen on this device may act as the kiosk. Set true only for
# testing the kiosk screen from another computer.
KIOSK_ALLOW_REMOTE=false

# --- First teacher account (used once by `npm run db:seed`) ---
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=
ADMIN_NAME=Teacher
KIOSK_NAME=Rainbow Room

# --- Hardware service (services/hardware, Python) ---
HARDWARE_URL=http://127.0.0.1:8765
# Must match HARDWARE_TOKEN in services/hardware/.env when set.
HARDWARE_TOKEN=

# --- Speech-to-text: ElevenLabs Scribe ---
# Without a key the kiosk uses the browser's speech recognition, or typing.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# --- Prompt processing, moderation and bilingual labels: OpenAI ---
# Without a key only the built-in English/Filipino word filter checks wishes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Image generation: Google Gemini ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# What to use when Gemini has no key or fails: pollinations (free) or none.
IMAGE_FALLBACK=pollinations
