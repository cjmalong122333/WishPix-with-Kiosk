# WishPix hardware service. Copy to .env.

# mock: no printer, pages are saved as PNG files in STATE_DIR/pages (development).
# cups: print through CUPS (the Raspberry Pi with the HP OfficeJet 250). Recommended.
# escpos: an optional 58 mm thermal printer (ESC/POS), see ESCPOS_* below.
PRINTER_MODE=mock
# Page layout: 4x6 (inkjet sticker paper, recommended) or 58mm (thermal roll).
# Empty = 58mm with PRINTER_MODE=escpos, 4x6 otherwise. Set 58mm with mock to
# see thermal pages without the printer.
PAGE_FORMAT=
# CUPS queue name, see `lpstat -p`. Empty = the CUPS default printer.
CUPS_PRINTER=
# CUPS options for 4x6 in (4R) inkjet sticker paper.
CUPS_MEDIA=4x6
CUPS_EXTRA_OPTIONS=fit-to-page print-quality=4

# Optional 58 mm thermal printer (PRINTER_MODE=escpos): a USB device, or
# tcp://<printer-ip>:9100 for a network printer. Pages are 384 dots wide.
ESCPOS_DEVICE=/dev/usb/lp0
# Cut the paper after each page (printers without a cutter ignore it).
ESCPOS_CUT=true
# Print speed in mm per second (from the printer's manual; 50-90 is usual).
ESCPOS_MM_PER_SECOND=50

# Sheets the tray holds (or pages per thermal roll); the teacher presses "Refill paper" after loading it.
PAPER_CAPACITY=20

# Where the service keeps its state (paper count, ink) and finished pages.
STATE_DIR=./data
# Keep the last N print-ready pages (mock mode shows them; CUPS mode keeps them for reprints and checks).
KEEP_PAGES=200

# Must match HARDWARE_TOKEN in apps/web/.env when set.
HARDWARE_TOKEN=

# Optional: a TTF font for titles and dotted tracing letters.
# Default: DejaVu Sans Bold on Raspberry Pi OS, Arial Bold on Windows.
FONT_PATH=
